# API-only image for Render Free (frontend on Vercel)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# CPU-only Torch first (avoids huge CUDA wheels that OOM on Free 512MB)
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.txt

COPY backend ./backend
COPY data ./data

ENV PYTHONUNBUFFERED=1
ENV SERVE_FRONTEND=false
ENV CORS_ORIGINS=*
ENV TOKENIZERS_PARALLELISM=false
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV HF_HOME=/tmp/hf
ENV TRANSFORMERS_CACHE=/tmp/hf

# Render sets PORT (usually 10000). Bind 0.0.0.0 so health checks pass.
CMD ["sh", "-c", "echo Starting on PORT=$PORT && uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
