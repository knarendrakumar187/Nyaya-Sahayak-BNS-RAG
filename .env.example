# Copy to .env and fill keys. Never commit .env.

GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local Vite: list origins. Docker / same-origin: *
# Vercel UI + separate API: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Protect upload/ingest/delete when set (header: X-API-Key)
API_KEY=
ENABLE_AUTH=true
RATE_LIMIT=30/minute

# true = serve frontend/dist from FastAPI (Docker one-URL)
# false = API-only (use when UI is on Vercel)
SERVE_FRONTEND=true
