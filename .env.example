# Copy this file to .env and fill in ONE API key.

# Option A — Google Gemini (free tier: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option B — OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# "gemini" or "openai"
LLM_PROVIDER=gemini

# Free-tier friendly default for new Google AI Studio keys
GEMINI_MODEL=gemini-3.1-flash-lite

# Local embeddings (free, no API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS origin for React dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
