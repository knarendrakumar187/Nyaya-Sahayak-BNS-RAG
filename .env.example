# Copy to .env and fill in your keys. Never commit .env to git.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Option A — Google Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Option B — OpenAI
OPENAI_API_KEY=

# "gemini" or "openai"
LLM_PROVIDER=gemini

# Correct free-tier Gemini model. Options: gemini-2.0-flash-lite, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local embeddings (free, no API key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev: list origins. Docker / same-origin: *
# Production (Vercel + separate Render API): set to your exact Vercel URL, e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ── Auth & Security ───────────────────────────────────────────────────────────
# Set a strong random string to protect upload/ingest/delete endpoints.
# Clients must send header: X-API-Key: <this value>
# Leave empty to disable key protection (not recommended in production).
API_KEY=

# false for easy first deploy / local. Set true + API_KEY to lock upload/ingest/delete.
ENABLE_AUTH=false

# Rate limiting (slowapi format: N/period)
RATE_LIMIT=30/minute

# ── Memory-safe PDF indexing (Render Free = 512 MB) ───────────────────────────
# 0 = unlimited (safe locally). Lower values prevent OOM on free tier.
MAX_PDF_PAGES=30
MAX_INDEX_CHUNKS=150
EMBED_BATCH_SIZE=16
