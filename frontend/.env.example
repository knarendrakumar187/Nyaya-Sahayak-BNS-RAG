# ── Local `npm run dev` ───────────────────────────────────────────────────────
# Leave unset (or empty). api.js uses the Vite proxy: /api → http://localhost:8000
# VITE_API_BASE_URL=

# ── Vercel (Production + Preview) ─────────────────────────────────────────────
# REQUIRED after a fresh Render deploy — paste your real Render URL (no slash):
# VITE_API_BASE_URL=https://nyaya-sahayak-api.onrender.com
#
# Do NOT leave this pointing at an old/deleted Render service.
# Do NOT rely on same-origin /api if Vercel Deployment Protection (SSO) is on.

VITE_API_BASE_URL=https://nyaya-sahayak-api.onrender.com
