# On Vercel: LEAVE THIS EMPTY (or unset).
# The root vercel.json proxies /api/* → Render, so the browser uses same-origin /api
# and avoids cross-origin "Failed to fetch".
#
# Only set this for local split testing without the Vite proxy:
# VITE_API_BASE_URL=https://nyaya-sahayak-api.onrender.com
VITE_API_BASE_URL=
